node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# Private, host-specific deployment config/notes (docker.tuxhpc.net and
# friends). Contains real secrets and internal infra details - never commit.
# A second .gitignore lives inside the folder itself as defense-in-depth in
# case this rule is ever edited or dropped.
/deploy/local/*
!/deploy/local/.gitignore
